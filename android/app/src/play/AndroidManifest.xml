<!-- Play Store build (built with -PplayStore=true): Google Play does not
     allow a game to keep a foreground service running or to ask for the
     battery optimisation exception, so both are removed here. The app then
     only receives invites and messages while it is open. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <application>
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            tools:node="remove" />
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RestartReceiver"
            tools:node="remove" />
    </application>
</manifest>
