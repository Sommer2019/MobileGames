# PC build of the Switch version, for trying it out and for the tests:
#   make -f Makefile.pc && ./build_pc/mobilegames
#   make -f Makefile.pc test
CXX ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra
SDL_FLAGS := $(shell pkg-config --cflags --libs sdl2 SDL2_ttf)
SOURCES := $(wildcard source/*.cpp)

build_pc/mobilegames: $(SOURCES) $(wildcard source/*.hpp)
	@mkdir -p build_pc
	$(CXX) $(CXXFLAGS) $(SOURCES) $(SDL_FLAGS) -o $@

build_pc/logic_test: tests/logic_test.cpp source/logic.cpp source/logic.hpp
	@mkdir -p build_pc
	$(CXX) $(CXXFLAGS) -Isource tests/logic_test.cpp source/logic.cpp -o $@

build_pc/logic2_test: tests/logic2_test.cpp source/logic2.cpp source/logic2.hpp source/logic.cpp
	@mkdir -p build_pc
	$(CXX) $(CXXFLAGS) -Isource tests/logic2_test.cpp source/logic2.cpp source/logic.cpp -o $@

test: build_pc/logic_test build_pc/logic2_test
	./build_pc/logic_test
	./build_pc/logic2_test

.PHONY: test
